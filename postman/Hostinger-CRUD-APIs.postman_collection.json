{
  "info": {
    "_postman_id": "wm-hostinger-crud-next",
    "name": "Hostinger CRUD APIs (Next.js)",
    "description": "Next.js parity of Hostinger PHP endpoints:\n`/api/api_users`, `api_tickets`, `api_ticket_statuses`, `api_shipments`, `api_orders`, `api_customers`, `api_category_issues`, `api_bl_products`, `api_baseorders`\n\n## Setup (local DB)\n1. `DATABASE_URL` → local MySQL in `.env`\n2. Set `CRUD_API_KEY=dev-test-key` in `.env`\n3. `npm run dev`\n4. Import this collection + environment **Warranty Management Local**\n5. Select that environment; header `x-crud-api-key` is set at collection level\n\n## Auth\nUse `x-crud-api-key: {{crudApiKey}}` **or** run Admin Login from the main Next.js collection (cookie).\n\nPrefer GET while exploring. POST/PUT/DELETE change local DB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key", "value": "x-crud-api-key", "type": "string" },
      { "key": "value", "value": "{{crudApiKey}}", "type": "string" },
      { "key": "in", "value": "header", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "crudApiKey", "value": "dev-test-key" },
    { "key": "ticketId", "value": "1" },
    { "key": "ticketSearch", "value": "WR2026100276" },
    { "key": "orderId", "value": "1" },
    { "key": "customerId", "value": "1" },
    { "key": "userId", "value": "1" },
    { "key": "shipmentId", "value": "1" },
    { "key": "awbNumber", "value": "90690644833" },
    { "key": "categoryIssueId", "value": "1" },
    { "key": "blProductId", "value": "1" },
    { "key": "baseorderId", "value": "1" },
    { "key": "statusId", "value": "1" },
    { "key": "page", "value": "1" },
    { "key": "limit", "value": "10" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/health",
            "description": "Confirms app + DB connection (no CRUD key needed)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. api_users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/api_users",
            "description": "Returns `{ status, total, data }` (all admin users)."
          },
          "response": []
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/api_users?id={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api_users"],
              "query": [{ "key": "id", "value": "{{userId}}" }]
            }
          },
          "response": []
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"postman_user\",\n  \"password\": \"Test@1234\",\n  \"full_name\": \"Postman Test User\",\n  \"email\": \"postman@example.com\",\n  \"role\": \"support\"\n}"
            },
            "url": "{{baseUrl}}/api/api_users",
            "description": "Required: username, password, full_name."
          },
          "response": []
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{userId}},\n  \"full_name\": \"Updated Name\",\n  \"email\": \"updated@example.com\",\n  \"role\": \"support\",\n  \"is_active\": 1\n}"
            },
            "url": "{{baseUrl}}/api/api_users"
          },
          "response": []
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/api_users?id={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api_users"],
              "query": [{ "key": "id", "value": "{{userId}}" }]
            },
            "description": "Destructive — uses local DB only with your current DATABASE_URL."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. api_tickets",
      "item": [
        {
          "name": "List tickets (page)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/api_tickets?page={{page}}&limit={{limit}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api_tickets"],
              "query": [
                { "key": "page", "value": "{{page}}" },
                { "key": "limit", "value": "{{limit}}" }
              ]
            },
            "description": "Check channel via linked order later. See selected_products_json for product count."
          },
          "response": []
        },
        {
          "name": "Search ticket",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/api_tickets?search={{ticketSearch}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api_tickets"],
              "query": [{ "key": "search", "value": "{{ticketSearch}}" }]
            },
            "description": "New vs existing: if search finds a row, ticket exists."
          },
          "response": []
        },
        {
          "name": "Get ticket by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/api_tickets?id={{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api_tickets"],
              "query": [{ "key": "id", "value": "{{ticketId}}" }]
            },
            "description": "Inspect selected_products_json (multi-product on one ticket) and status_id."
          },
          "response": []
        },
        {
          "name": "Create ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": {{orderId}},\n  \"product_id\": 1,\n  \"customer_description\": \"Postman test claim — product not working\",\n  \"ticket_type_id\": 1,\n  \"issue_type_id\": 1,\n  \"priority\": \"medium\",\n  \"selected_products_json\": [\n    { \"sku\": \"TEST-SKU-1\", \"name\": \"Test Product 1\", \"quantity\": 1 },\n    { \"sku\": \"TEST-SKU-2\", \"name\": \"Test Product 2\", \"quantity\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/api_tickets",
            "description": "Required: order_id, product_id, customer_description. Multiple products go in selected_products_json on ONE ticket."
          },
          "response": []
        },
        {
          "name": "Update ticket",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ticket_id\": {{ticketId}},\n  \"priority\": \"high\",\n  \"internal_notes\": \"Updated via Postman\"\n}"
            },
            "url": "{{baseUrl}}/api/api_tickets"
          },
          "response": []
        },
        {
          "name": "Delete ticket",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/api_tickets?id={{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "api_tickets"],
              "query": [{ "key": "id", "value": "{{ticketId}}" }]
            }
          },
          "response": []
        }
      ]
    },
