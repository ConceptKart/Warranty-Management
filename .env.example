# MySQL — same database as legacy PHP (u590978274_warmanagement)
# Import dump first: u590978274_warmanagement (1).sql
# Special chars in password must be URL-encoded (@ → %40, # → %23)

DATABASE_URL="mysql://root:PASSWORD@localhost:3306/warranty_management"

# Session secret for admin auth (min 32 characters)
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32"

# SMTP (mirrors config/email.php) — quote password if it contains #
SMTP_ENABLED="true"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USERNAME="no-reply@warranty.conceptkart.co.in"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="no-reply@warranty.conceptkart.co.in"
SMTP_FROM_NAME="Concept Kart"

# Hostinger Shipway DB (mirrors config/external_db.php) — Shopify AWB classification
# EXTERNAL_SHIPWAY_DATABASE_URL="mysql://user:password@srv1087.hstgr.io:3306/u590978274_returnorders"

# Remote claim attachment upload (mirrors warrantyreplacement.php)
# WARRANTY_UPLOAD_URL="https://conceptkart.co.in/warrantyreplacement.php"

# Optional Shipway overrides (defaults load from shipway_config table)
# SHIPWAY_EMAIL="operations@conceptkart.com"
# SHIPWAY_API_KEY="your-shipway-api-key"
# SHIPWAY_TIMEOUT="30"

# Cron protection for /api/cron/* (send as x-cron-secret header)
# CRON_SECRET="change-me-long-random-cron-secret"

# BaseLinker order syncs (cron/baselinker_sync.php + amazon_sync.php)
# BASELINKER_TOKEN="your-baselinker-token"
# BASELINKER_API_URL="https://api.baselinker.com/connector.php"
# BASELINKER_SHOPIFY_SOURCE_ID="9000436"
# BASELINKER_AMAZON_SOURCE_IDS="155,306,307"
